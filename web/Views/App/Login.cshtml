@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Event Desk Login</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-body">
<main class="auth-panel">
    <p class="brand">Showcase Event Desk</p>
    <h1>Sign in</h1>
    <p class="lede">Student · Advisor · Evaluator · SuperAdmin</p>
    @if (ViewBag.Error != null) { <p class="error">@ViewBag.Error</p> }
    <form method="post" asp-action="Login">
        <label>Email <input name="email" type="email" value="admin@fyp.local" required /></label>
        <label>Password <input name="password" type="password" value="Admin@123" required /></label>
        <button type="submit">Continue</button>
    </form>
    <p class="hint">admin@fyp.local / Admin@123 · student@fyp.local / Student@123 · advisor.ai@fyp.local / Advisor@123 · eval.ai@fyp.local / Eval@123</p>
</main>
</body>
</html>
